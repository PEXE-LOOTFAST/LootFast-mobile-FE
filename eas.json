{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_GOONG_MAPTILES_KEY": "map_key_cua_ban",
        "EXPO_PUBLIC_API_URL": "https://api.cua-ban.com"
      }
    }
  }
}
