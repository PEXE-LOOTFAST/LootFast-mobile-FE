# Copy file này thành .env rồi điền giá trị thật.
# Sau khi sửa .env phải restart: npx expo start --clear (env KHÔNG hot-reload).
#
# CẢNH BÁO: biến EXPO_PUBLIC_* được nhúng thẳng vào bundle JavaScript lúc build.
# Ai tải APK về cũng đọc được. Tuyệt đối không đặt JWT secret, PayOS key hay
# HMAC secret ở đây — những thứ đó chỉ sống ở backend.

EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Đăng nhập bằng Google. Mỗi nền tảng một OAuth client id, và cả ba phải nằm trong
# GOOGLE_CLIENT_IDS của backend vì backend đối chiếu `aud` của id token.
# Để trống thì nút Google vẫn hiện nhưng kèm ghi chú là chưa cấu hình.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# Bản đồ Goong (tab Bản đồ). Lấy khoá "Maptiles" tại https://account.goong.io/keys.
# Khoá này nằm trong bundle app, nên hãy giới hạn nó theo ứng dụng ở trang quản lý Goong.
EXPO_PUBLIC_GOONG_MAPTILES_KEY=
