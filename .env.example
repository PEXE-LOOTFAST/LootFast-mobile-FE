# Copy file này thành .env rồi điền giá trị thật.
# Sau khi sửa .env phải restart: npx expo start --clear (env KHÔNG hot-reload).
#
# CẢNH BÁO: biến EXPO_PUBLIC_* được nhúng thẳng vào bundle JavaScript lúc build.
# Ai tải APK về cũng đọc được. Tuyệt đối không đặt JWT secret, PayOS key hay
# HMAC secret ở đây — những thứ đó chỉ sống ở backend.

EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Kênh realtime (STOMP qua WebSocket). Bỏ trống thì app tự suy ra từ API_URL: bỏ /api/v1, đổi
# http→ws, thêm /ws (vd. https://x.onrender.com/api/v1 → wss://x.onrender.com/ws).
# EXPO_PUBLIC_WS_URL=

# Tài khoản nhận tiền gói Cao cấp (thanh toán bằng chuyển khoản VietQR, admin đối soát rồi kích hoạt).
# BIN là mã ngân hàng 6 chữ số của NAPAS (vd. Vietcombank 970436). Số tài khoản vốn đưa công khai
# cho người chuyển nên để ở EXPO_PUBLIC_ được. Bỏ trống thì màn gói báo tạm chưa nhận đăng ký.
EXPO_PUBLIC_PREMIUM_BANK_BIN=
EXPO_PUBLIC_PREMIUM_BANK_NAME=
EXPO_PUBLIC_PREMIUM_ACCOUNT_NUMBER=
EXPO_PUBLIC_PREMIUM_ACCOUNT_NAME=

# Đăng nhập bằng Google (chỉ Android). Điền OAuth client id loại **Web** và đặt đúng id đó vào
# GOOGLE_CLIENT_IDS của backend, vì backend đối chiếu `aud` của id token.
# Cần thêm một client loại Android (package vn.lootfast.app + SHA-1) trên Google Cloud.
# Để trống thì nút Google vẫn hiện nhưng kèm ghi chú là chưa cấu hình.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Bản đồ Goong (tab Bản đồ). Lấy khoá "Maptiles" tại https://account.goong.io/keys.
# Khoá này nằm trong bundle app, nên hãy giới hạn nó theo ứng dụng ở trang quản lý Goong.
EXPO_PUBLIC_GOONG_MAPTILES_KEY=

# Dịch vụ dữ liệu Goong (tự điền địa chỉ quán từ vị trí đã chọn). Tạo khoá loại "API Key" (khác Maptiles Key)
# tại https://account.goong.io/keys. Khoá này cũng nằm trong bundle app: hãy giới hạn theo ứng dụng.
EXPO_PUBLIC_GOONG_API_KEY=
